<script>
  // The greeting quickly says "Welcome" in every language, then settles on the page language.
  // The whole sequence takes under five seconds and does not repeat.
  const greet = document.querySelector<HTMLElement>('[data-greet]');
  if (greet && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...greet.querySelectorAll<HTMLElement>('.greet__word')];
    const current = words.findIndex((w) => w.hasAttribute('data-current'));
    const order = [...words.slice(current + 1), ...words.slice(0, current + 1)];
    const flags = document.querySelectorAll<HTMLElement>('.flags a');
    const hot = (l?: string) => flags.forEach((f) => f.classList.toggle('is-hot', f.dataset.l === l));
    let step = 0;
    greet.classList.add('is-cycling');
    const tick = () => {
      words.forEach((w) => w.classList.remove('is-on'));
      const w = order[step];
      w.classList.add('is-on');
      hot(step < order.length - 1 ? w.dataset.l : undefined);
      step++;
      if (step < order.length) setTimeout(tick, 650);
      else greet.classList.remove('is-cycling');
    };
    setTimeout(tick, 1200);
  }
</script>
