---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Flag from '../components/Flag.astro';
import Mark from '../components/Mark.astro';
import { photoUrl, photoSrcset, photos } from '../config/photos';
import { site, whatsappLink } from '../config/site';
import { allDicts, getDict, locales, localeInfo, localePath, type Locale } from '../i18n';
import { rich } from '../lib/rich';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const h = t.home;
const num = (i: number) => String(i + 1).padStart(2, '0');

const greetings = locales.map((l) => ({ l, text: allDicts[l].greeting, info: localeInfo[l] }));
const posts = (await getCollection('blog', (e) => e.id.startsWith(`${locale}/`)))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const post = posts[0];
const postSlug = post?.id.split('/').slice(1).join('/');
const faqPreview = t.faq.items.slice(1, 5);
---
<Base
  locale={locale}
  path=""
  title={h.title}
  description={h.description}
  preloadImage={{ href: photoUrl('pullsFerry', 1600), srcset: photoSrcset('pullsFerry'), sizes: '100vw' }}
>
  <!-- Hero -->
  <section class="hero dark" aria-labelledby="hero-title">
    <div class="hero__media" aria-hidden="true">
      <Photo name="pullsFerry" locale={locale} eager decorative sizes="100vw" />
    </div>
    <div class="hero__veil" aria-hidden="true"></div>
    <div class="hero__cone" aria-hidden="true"></div>

    <div class="wrap hero__inner">
      <p class="hero__eyebrow">{h.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        {h.heroA}<br />
        <span class="line--accent">{h.heroB}</span>
      </h1>
      <p class="hero__lead">{h.heroLead}</p>
      <div class="hero__ctas">
        <a class="btn" href={localePath(locale, 'contact')}>{t.cta.book}<svg class="arrow" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <a class="btn btn--ghost" href={localePath(locale, 'services')}>{t.cta.allServices}</a>
      </div>
    </div>

    <div class="wrap hero__langs">
      <div class="greet" data-greet aria-hidden="true">
        {greetings.map((g) => (
          <span class="greet__word" lang={g.info.htmlLang} dir={g.info.dir} data-l={g.l} data-current={g.l === locale ? '' : undefined}>{g.text}</span>
        ))}
      </div>
      <p class="hero__langs-label">{h.langPrompt}</p>
      <ul class="flags" role="list">
        {greetings.map((g) => (
          <li>
            <a href={localePath(g.l)} data-set-lang={g.l} data-l={g.l} hreflang={g.info.hreflang} aria-current={g.l === locale ? 'true' : undefined}>
              <Flag code={g.info.flag} size={16} />
              <span lang={g.info.htmlLang} dir={g.info.dir}>{g.info.name}{g.info.variant && <small> {g.info.variant}</small>}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Intro -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="wrap intro__grid">
      <p class="kicker" data-reveal>{h.introKicker}</p>
      <h2 id="intro-title" class="intro__statement" data-reveal>{h.introStatement}</h2>
      <div class="intro__body" data-reveal style="--delay: 120ms">
        <Mark />
        <p class="lead">{h.introBody}</p>
      </div>
    </div>
  </section>

  <!-- Services index -->
  <section class="section services ivory-2" aria-labelledby="services-title">
    <div class="wrap">
      <header class="sec-head">
        <p class="kicker" data-reveal>{h.servicesKicker}</p>
        <h2 id="services-title" class="h2" data-reveal>{h.servicesTitle}</h2>
        <p class="lead" data-reveal>{h.servicesLead}</p>
      </header>
      <ol class="index" role="list">
        {t.services.items.map((s, i) => (
          <li data-reveal style={`--delay:${i * 40}ms`}>
            <details class="row">
              <summary>
                <span class="row__num">{num(i)}</span>
                <span class="row__title">{s.title}</span>
                <span class="row__short">{s.short}</span>
                <span class="row__icon" aria-hidden="true"></span>
              </summary>
              <div class="row__body">
                <ul role="list">{s.points.map((p) => <li set:html={rich(p)} />)}</ul>
              </div>
            </details>
          </li>
        ))}
      </ol>
      <p class="more"><a class="text-link" href={localePath(locale, 'services')}>{t.cta.allServices}<svg class="arrow" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a></p>
    </div>
  </section>

  <!-- How it works -->
  <section class="how dark" aria-labelledby="how-title">
    <div class="how__media">
      <Photo name="letter" locale={locale} sizes="(min-width: 64rem) 50vw, 100vw" />
    </div>
    <div class="how__content">
      <p class="kicker" data-reveal>{h.howKicker}</p>
      <h2 id="how-title" class="h2" data-reveal>{h.howTitle}</h2>
      <ol class="steps" role="list">
        {t.how.steps.map((s, i) => (
          <li data-reveal style={`--delay:${i * 70}ms`}>
            <span class="steps__num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="steps__title">{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <a class="btn btn--ghost" href={localePath(locale, 'how-it-works')}>{t.cta.howItWorks}</a>
    </div>
  </section>

  <!-- Principles -->
  <section class="section principles" aria-labelledby="principles-title">
    <div class="wrap">
      <header class="sec-head sec-head--center">
        <Mark />
        <p class="kicker" data-reveal>{h.principlesKicker}</p>
        <h2 id="principles-title" class="h2" data-reveal>{h.principlesTitle}</h2>
      </header>
      <div class="pgrid">
        {h.principles.map((p, i) => (
          <article class="pcell" data-reveal style={`--delay:${i * 80}ms`}>
            <span class="pcell__num">{num(i)}</span>
            <h3 class="h3">{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Languages -->
  <section class="section langs dark" aria-labelledby="langs-title">
    <div class="langs__glow" aria-hidden="true"></div>
    <div class="wrap">
      <header class="sec-head">
        <p class="kicker" data-reveal>{h.langKicker}</p>
        <h2 id="langs-title" class="h2" data-reveal>{h.langTitle}</h2>
        <p class="lead" data-reveal>{h.langText}</p>
      </header>
      <ul class="tiles" role="list">
        {greetings.map((g, i) => (
          <li data-reveal style={`--delay:${i * 60}ms`}>
            <a class="tile" href={localePath(g.l)} data-set-lang={g.l} hreflang={g.info.hreflang} aria-current={g.l === locale ? 'true' : undefined}>
              <Flag code={g.info.flag} size={22} />
              <span class="tile__greet" lang={g.info.htmlLang} dir={g.info.dir}>{g.text}</span>
              <span class="tile__name" lang={g.info.htmlLang} dir={g.info.dir}>{g.info.name}{g.info.variant && ` · ${g.info.variant}`}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ preview -->
  <section class="section faqp" aria-labelledby="faqp-title">
    <div class="wrap faqp__grid">
      <header>
        <p class="kicker" data-reveal>{h.faqKicker}</p>
        <h2 id="faqp-title" class="h2" data-reveal>{h.faqTitle}</h2>
        <p class="more"><a class="text-link" href={localePath(locale, 'faq')}>{t.cta.allQuestions}</a></p>
      </header>
      <div class="qa">
        {faqPreview.map((f) => (
          <details class="qa__item" data-reveal>
            <summary><span>{f.q}</span><span class="row__icon" aria-hidden="true"></span></summary>
            <p set:html={rich(f.a)} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Journal -->
  {post && (
    <section class="section section--tight journal ivory-2" aria-labelledby="journal-title">
      <div class="wrap">
        <p class="kicker">{h.journalKicker}</p>
        <h2 id="journal-title" class="visually-hidden">{h.journalTitle}</h2>
        <a class="story" href={localePath(locale, `blog/${postSlug}`)} data-reveal>
          <div class="story__media"><Photo name={post.data.image} locale={locale} sizes="(min-width: 64rem) 55vw, 100vw" /></div>
          <div class="story__text">
            <p class="story__meta">{post.data.readMinutes} {t.blog.minRead}</p>
            <h3 class="story__title">{post.data.title}</h3>
            <p class="muted">{post.data.description}</p>
            <span class="text-link">{t.cta.readJournal}</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Final call -->
  <section class="final dark" aria-labelledby="final-title">
    <div class="final__media" aria-hidden="true"><Photo name="elmHill" locale={locale} decorative sizes="100vw" /></div>
    <div class="final__veil" aria-hidden="true"></div>
    <div class="wrap final__inner">
      <img class="final__logo" src="/logo.svg" width="88" height="88" alt="" loading="lazy" decoding="async" />
      <h2 id="final-title" class="final__title" data-reveal>{h.finalTitle}</h2>
      <p class="lead" data-reveal>{h.finalText}</p>
      <div class="final__ctas" data-reveal>
        <a class="btn" href={whatsappLink(t.contact.waPrefill)} rel="noopener" target="_blank">{t.cta.whatsappLong}<span class="visually-hidden"> ({t.a11y.newTab})</span></a>
        <a class="btn btn--ghost" href={`tel:${site.phoneHref}`}>{t.cta.call}</a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}>{t.cta.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media { position: absolute; inset: 0; z-index: -3; background: var(--midnight-800); }
  .hero__media :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%;
    filter: saturate(0.55) contrast(1.08) brightness(0.8);
    transform: scale(1.06);
    animation: settle 2.4s var(--ease-out) both;
  }
  @keyframes settle { from { transform: scale(1.14); opacity: 0.2; } }
  .hero__veil {
    position: absolute; inset: 0; z-index: -2;
    background:
      radial-gradient(90% 70% at 50% 0%, rgba(44, 67, 119, 0.6), transparent 60%),
      linear-gradient(180deg, rgba(4, 7, 15, 0.55) 0%, rgba(4, 7, 15, 0.35) 35%, rgba(4, 7, 15, 0.82) 72%, var(--midnight-950) 100%);
  }
  /* The light cone from the logo, falling from the top of the page */
  .hero__cone {
    position: absolute; z-index: -1;
    top: 0; left: 50%;
    width: min(70rem, 140vw); height: 100%;
    transform: translateX(-50%);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0) 75%);
    clip-path: polygon(38% 0, 62% 0, 84% 100%, 16% 100%);
    mix-blend-mode: screen;
    animation: cone 2.8s var(--ease-out) 0.2s both;
    pointer-events: none;
  }
  @keyframes cone { from { opacity: 0; transform: translateX(-50%) scaleY(0.6); transform-origin: top; } }

  .hero__inner {
    align-self: center;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: 3rem;
    text-align: center;
    display: flex; flex-direction: column; align-items: center;
  }
  .hero__eyebrow {
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.32em; text-transform: uppercase;
    color: var(--silver-300);
    margin-bottom: 2rem;
    white-space: pre;
    animation: fadeUp 1s var(--ease-out) 0.3s both;
  }
  :global(:lang(ckb)) .hero__eyebrow { letter-spacing: 0; font-size: 0.9rem; }
  .hero__title {
    font-size: clamp(3.25rem, 10.5vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    font-weight: 500;
    color: var(--silver-50);
    margin-bottom: 2rem;
  }
  :global(:lang(ckb)) .hero__title { font-size: clamp(2.5rem, 7.5vw, 6rem); line-height: 1.3; letter-spacing: 0; }
  :global(:lang(bg)) .hero__title, :global(:lang(ro)) .hero__title, :global(:lang(tr)) .hero__title, :global(:lang(ku)) .hero__title { font-size: clamp(2.75rem, 8.5vw, 7.5rem); }
  .hero__title { animation: rise 1.2s var(--ease-out) both; }
  .line--accent {
    font-style: italic;
    padding-bottom: 0.08em;
    background: var(--brushed);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  :global(:lang(ckb)) .line--accent { font-style: normal; }
  .hero__lead {
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    color: var(--silver-200);
    margin-bottom: 2.5rem;
    animation: fadeUp 1.2s var(--ease-out) 0.3s both;
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; animation: fadeUp 1.2s var(--ease-out) 0.45s both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } }
  /* The headline is the largest element: keep it visible from the first frame so it paints immediately */
  @keyframes rise { from { transform: translateY(18px); } }

  .hero__langs {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-top: 1.75rem;
    padding-bottom: 2rem;
    border-top: 1px solid rgba(188, 195, 208, 0.16);
    animation: fadeUp 1.2s var(--ease-out) 0.7s both;
  }
  .greet { position: relative; grid-row: span 2; min-width: 11rem; height: 3rem; }
  .greet__word {
    position: absolute; inset-inline-start: 0; top: 50%;
    font-family: var(--font-display); font-style: italic; font-size: 2rem; line-height: 1;
    color: var(--silver-50);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-30%);
    filter: blur(6px);
    transition: opacity 0.45s var(--ease-out), transform 0.6s var(--ease-out), filter 0.45s;
  }
  .greet__word:global([dir='rtl']), .greet__word[lang='ckb'] { font-family: Tahoma, 'Segoe UI', 'Noto Sans Arabic', sans-serif; font-style: normal; font-size: 1.6rem; }
  :global(:lang(ckb)) .greet__word[lang='ckb'] { font-family: var(--font-display); }
  .greet__word[data-current], .greet__word.is-on { opacity: 1; transform: translateY(-50%); filter: none; }
  .greet.is-cycling .greet__word[data-current]:not(.is-on) { opacity: 0; transform: translateY(-70%); filter: blur(6px); }
  .hero__langs-label { margin: 0; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--silver-400); }
  :global(:lang(ckb)) .hero__langs-label { letter-spacing: 0; font-size: 0.875rem; }
  .flags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .flags a {
    display: inline-flex; align-items: center; gap: 0.55rem;
    min-height: 2.5rem; padding: 0.35rem 0.85rem 0.35rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(232, 236, 242, 0.16);
    background: rgba(255, 255, 255, 0.04);
    color: var(--silver-100);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: background 0.2s, border-color 0.2s, transform 0.1s;
  }
  .flags a:hover, .flags a.is-hot { background: rgba(255, 255, 255, 0.1); border-color: rgba(232, 236, 242, 0.4); }
  .flags a:active { transform: scale(0.96); }
  .flags a[aria-current] { border-color: rgba(232, 236, 242, 0.6); }
  .flags small { color: var(--silver-400); }
  .flags [lang='ckb'] { font-family: Tahoma, 'Segoe UI', 'Noto Sans Arabic', sans-serif; }
  :global(:lang(ckb)) .flags [lang='ckb'] { font-family: var(--font-body); }

  @media (max-width: 48rem) {
    .hero__inner { text-align: start; align-items: flex-start; }
    .hero__ctas { justify-content: flex-start; }
    .hero__ctas .btn { flex: 1 1 100%; }
    .hero__langs { grid-template-columns: 1fr; }
    .greet { grid-row: auto; height: 2.5rem; }
    .flags { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scrollbar-width: none; }
    .flags a { flex: none; }
  }

  /* ---------- Intro ---------- */
  .intro__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0 2rem; }
  .intro .kicker { grid-column: 1 / -1; }
  .intro__statement {
    grid-column: 1 / span 10;
    font-size: clamp(2rem, 4.8vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 3rem;
  }
  .intro__body { grid-column: 6 / -1; display: grid; gap: 1.5rem; color: var(--midnight-600); }
  @media (max-width: 56rem) {
    .intro__statement, .intro__body { grid-column: 1 / -1; }
  }

  /* ---------- Section heads ---------- */
  .sec-head { max-width: 46rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sec-head .h2 { margin-bottom: 1.25rem; }
  .sec-head--center { margin-inline: auto; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .sec-head--center :global(.mark) { color: var(--midnight-600); margin-bottom: 1.5rem; }

  /* ---------- Services index ---------- */
  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ivory-line); }
  .index > li { border-bottom: 1px solid var(--ivory-line); }
  .row summary {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1.1fr) minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem 0;
    cursor: pointer;
    list-style: none;
    transition: padding 0.4s var(--ease-out);
  }
  .row summary::-webkit-details-marker { display: none; }
  .row summary:hover .row__title { color: var(--midnight-600); }
  .row__num { font-family: var(--font-display); font-style: italic; font-size: 1.125rem; color: var(--ink-muted); }
  .row__title { font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.25rem); line-height: 1.1; transition: color 0.2s; }
  :global(:lang(ckb)) .row__title { font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.5; }
  .row__short { color: var(--ink-soft); font-size: 0.975rem; }
  .row__icon {
    position: relative; justify-self: end;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    border: 1px solid var(--ivory-line);
    transition: background 0.3s, border-color 0.3s, transform 0.5s var(--spring);
  }
  .row__icon::before, .row__icon::after {
    content: ''; position: absolute; left: 50%; top: 50%;
    width: 12px; height: 1.5px; margin: -0.75px 0 0 -6px;
    background: currentColor; border-radius: 1px;
    transition: transform 0.5s var(--spring);
  }
  .row__icon::after { transform: rotate(90deg); }
  details[open] > summary .row__icon { background: var(--ink); border-color: var(--ink); color: var(--silver-50); transform: rotate(180deg); }
  details[open] > summary .row__icon::after { transform: rotate(0deg); }
  .row__body { padding: 0 0 2rem calc(3.5rem + 1.5rem); }
  :global([dir='rtl']) .row__body { padding: 0 calc(3.5rem + 1.5rem) 2rem 0; }
  .row__body ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem 2.5rem; list-style: none; margin: 0; padding: 0; }
  .row__body li { position: relative; padding-inline-start: 1.25rem; color: var(--ink-soft); }
  .row__body li::before { content: ''; position: absolute; inset-inline-start: 0; top: 0.7em; width: 6px; height: 6px; border-radius: 50%; background: var(--midnight-600); }
  details::details-content { transition: content-visibility 0.45s allow-discrete, height 0.45s var(--ease-out); height: 0; overflow: clip; }
  details[open]::details-content { height: auto; }
  @supports (interpolate-size: allow-keywords) { :root { interpolate-size: allow-keywords; } }
  @media (max-width: 48rem) {
    .row summary { grid-template-columns: 2.25rem minmax(0, 1fr) 2.5rem; gap: 0.25rem 1rem; padding: 1.4rem 0; }
    .row__short { grid-column: 2; grid-row: 2; font-size: 0.9rem; }
    .row__icon { grid-column: 3; grid-row: 1 / span 2; }
    .row__body { padding-inline-start: calc(2.25rem + 1rem); }
    :global([dir='rtl']) .row__body { padding-inline-end: calc(2.25rem + 1rem); padding-inline-start: 0; }
    .row__body ul { grid-template-columns: 1fr; }
  }
  .more { margin-top: 2.5rem; }

  /* ---------- How ---------- */
  .how { display: grid; grid-template-columns: 1fr 1fr; min-height: 44rem; }
  .how__media { position: relative; overflow: hidden; background: var(--midnight-800); }
  .how__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.7) brightness(0.85); }
  .how__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 60%, var(--midnight-950)); }
  :global([dir='rtl']) .how__media::after { background: linear-gradient(270deg, transparent 60%, var(--midnight-950)); }
  .how__content { padding: clamp(4rem, 9vw, 8rem) var(--gutter); max-width: 40rem; }
  .how__content .h2 { margin-bottom: 3rem; }
  .steps { list-style: none; margin: 0 0 3rem; padding: 0; display: grid; gap: 2rem; }
  .steps li { display: grid; grid-template-columns: 3.25rem 1fr; gap: 1.25rem; }
  .steps__num {
    display: grid; place-items: center;
    width: 3.25rem; height: 3.25rem; border-radius: 50%;
