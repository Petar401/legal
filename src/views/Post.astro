---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { photoUrl } from '../config/photos';
import { site } from '../config/site';
import { getDict, localePath, formatDate, localeInfo, type Locale } from '../i18n';

interface Props { locale: Locale; entry: CollectionEntry<'blog'> }
const { locale, entry } = Astro.props;
const t = getDict(locale);
const b = t.blog;
const slug = entry.id.split('/').slice(1).join('/');
const path = `blog/${slug}`;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const d = entry.data;
const url = site.url + localePath(locale, path);

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    inLanguage: localeInfo[locale].htmlLang,
    datePublished: d.published.toISOString().slice(0, 10),
    dateModified: d.checked.toISOString().slice(0, 10),
    image: photoUrl(d.image, 1200),
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: { '@id': `${site.url}/#organisation` },
    about: ['Norwich', 'Norfolk'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.nav.home, item: site.url + localePath(locale) },
      { '@type': 'ListItem', position: 2, name: t.nav.blog, item: site.url + localePath(locale, 'blog') },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base locale={locale} path={path} title={`${d.title} | ${site.name}`} description={d.description} type="article" image={photoUrl(d.image, 1200)} jsonLd={ld}>
  <article>
    <header class="ph dark">
      <div class="ph__media" aria-hidden="true"><Photo name={d.image} locale={locale} eager decorative /></div>
      <div class="ph__veil" aria-hidden="true"></div>
      <div class="wrap narrow ph__inner">
        <nav aria-label={t.a11y.breadcrumb} class="crumbs">
          <ol role="list">
            <li><a href={localePath(locale)}>{t.nav.home}</a></li>
            <li><a href={localePath(locale, 'blog')}>{t.nav.blog}</a></li>
          </ol>
        </nav>
        <h1 class="ph__title">{d.title}</h1>
        <p class="lead">{d.description}</p>
        <p class="ph__meta">
          <span>{b.published} <time datetime={d.published.toISOString().slice(0, 10)}>{formatDate(d.published, locale)}</time></span>
          <span>{d.readMinutes} {b.minRead}</span>
        </p>
      </div>
    </header>

    <div class="wrap body">
      {toc.length > 0 && (
        <nav class="toc" aria-labelledby="toc-title">
          <p id="toc-title" class="toc__title">{b.contents}</p>
          <ol role="list">{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose article">
        <Content />
        <aside class="facts">
          <p><strong>{b.checked}: <time datetime={d.checked.toISOString().slice(0, 10)}>{formatDate(d.checked, locale)}</time></strong></p>
          <p>{b.note}</p>
          <h2 class="facts__title">{b.sources}</h2>
          <ul role="list">{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank" lang="en" dir="ltr">{s.label}</a></li>)}</ul>
        </aside>
        <p><a class="text-link" href={localePath(locale, 'blog')}>{b.backToJournal}</a></p>
      </div>
    </div>
  </article>
  <CtaBand locale={locale} title={b.helpTitle} />
</Base>

<style>
  .ph { position: relative; overflow: hidden; isolation: isolate; padding: calc(var(--header-h) + clamp(4rem, 10vw, 8rem)) 0 clamp(3.5rem, 8vw, 6rem); }
  .ph__media { position: absolute; inset: 0; z-index: -2; background: var(--midnight-800); }
  .ph__media :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: 0.5; filter: saturate(0.6); }
  .ph__veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(4, 7, 15, 0.5), rgba(4, 7, 15, 0.94) 80%); }
  .ph__title { font-size: clamp(2.4rem, 6vw, 4.75rem); line-height: 1.02; letter-spacing: -0.025em; margin-bottom: 1.5rem; }
  :global(:lang(ckb)) .ph__title { font-size: clamp(1.9rem, 4.5vw, 3.25rem); line-height: 1.4; }
  .ph__meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; margin-top: 2rem; font-size: 0.8125rem; color: var(--silver-400); }
  .crumbs ol { display: flex; gap: 0.5rem; list-style: none; margin: 0 0 2.5rem; padding: 0; font-size: 0.8125rem; }
  .crumbs li + li::before { content: '/'; margin-inline-end: 0.5rem; opacity: 0.5; }
  .crumbs a { color: var(--silver-300); text-decoration: none; }
  .crumbs a:hover { color: #fff; text-decoration: underline; }

  .body { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); padding-block: clamp(3.5rem, 8vw, 6rem); }
  .toc { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  .toc__title { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 1rem; }
  :global(:lang(ckb)) .toc__title { letter-spacing: 0; font-size: 0.875rem; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; border-inline-start: 1px solid var(--ivory-line); }
  .toc a { display: block; padding-inline-start: 1rem; font-size: 0.875rem; color: var(--ink-soft); text-decoration: none; line-height: 1.4; }
  .toc a:hover { color: var(--ink); text-decoration: underline; }
  .article { font-size: 1.125rem; max-width: 42rem; }
  .article :global(h2) { scroll-margin-top: calc(var(--header-h) + 1.5rem); }
  .facts { margin: 3.5rem 0 2.5rem; padding: 1.75rem 2rem; border-radius: var(--radius); background: var(--ivory-2); border: 1px solid var(--ivory-line); font-size: 0.9375rem; }
  .facts__title { font-family: var(--font-body); font-size: 0.75rem !important; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; margin: 1.5rem 0 0.75rem !important; color: var(--ink-muted); }
  :global(:lang(ckb)) .facts__title { letter-spacing: 0; font-size: 0.875rem !important; }
  .facts ul { padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .facts li { padding: 0; }
  @media (max-width: 60rem) { .body { grid-template-columns: 1fr; } .toc { position: static; } }
</style>
