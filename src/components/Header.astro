---
import LangSwitcher from './LangSwitcher.astro';
import Wordmark from './Wordmark.astro';
import { getDict, localePath, type Locale } from '../i18n';
import { site, whatsappLink } from '../config/site';

interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;
const t = getDict(locale);

const links = [
  { key: 'services', label: t.nav.services },
  { key: 'how-it-works', label: t.nav.how },
  { key: 'about', label: t.nav.about },
  { key: 'blog', label: t.nav.blog },
  { key: 'faq', label: t.nav.faq },
];
const current = path.split('/')[0];
---
<header class="site-header" data-header>
  <div class="bar wrap">
    <a class="brand" href={localePath(locale)} aria-label={`${site.name}, ${t.nav.home}`}>
      <img src="/logo.svg" width="38" height="38" alt="" />
      <Wordmark />
    </a>

    <nav class="nav" aria-label={t.a11y.mainNav}>
      <ul role="list">
        {links.map((l) => (
          <li><a href={localePath(locale, l.key)} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <LangSwitcher locale={locale} path={path} />
      <a class="btn btn--sm cta" href={localePath(locale, 'contact')}>{t.nav.contact}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="burger__lines" aria-hidden="true"><span></span><span></span></span>
        <span class="visually-hidden" data-label-open>{t.a11y.menuOpen}</span>
        <span class="visually-hidden" data-label-close hidden>{t.a11y.menuClose}</span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="sheet" role="dialog" aria-modal="true" aria-label={t.a11y.mainNav} data-menu>
  <div class="sheet__inner wrap">
    <nav aria-label={t.a11y.mainNav}>
      <ol class="sheet__links" role="list">
        {[{ key: '', label: t.nav.home }, ...links, { key: 'contact', label: t.nav.contact }].map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={localePath(locale, l.key)} aria-current={current === l.key ? 'page' : undefined}>
              <span class="sheet__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {l.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="sheet__foot">
      <p class="sheet__label">{t.a11y.chooseLanguage}</p>
      <LangSwitcher locale={locale} path={path} variant="grid" />
      <div class="sheet__cta">
        <a class="btn" href={whatsappLink(t.contact.waPrefill)} rel="noopener" target="_blank">{t.cta.whatsappLong}<span class="visually-hidden"> ({t.a11y.newTab})</span></a>
        <a class="btn btn--ghost" href={`tel:${site.phoneHref}`}>{t.cta.call}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    color: var(--silver-100);
    transition: background 0.4s var(--ease-out), box-shadow 0.4s;
  }
  .site-header::before {
    /* Translucent material. Starts clear over the hero, thickens after scrolling. */
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(4, 7, 15, 0.55);
    -webkit-backdrop-filter: blur(20px) saturate(170%);
    backdrop-filter: blur(20px) saturate(170%);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }
  .site-header.is-scrolled::before, .site-header.is-solid::before { opacity: 1; }
  .bar { position: relative; height: 100%; display: flex; align-items: center; gap: 2rem; }

  .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--silver-50); flex: none; }
  .brand img { width: 2.375rem; height: 2.375rem; border-radius: 0.55rem; box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.8); }

  .nav { margin-inline-start: auto; }
  .nav ul { display: flex; gap: 0.25rem; list-style: none; margin: 0; padding: 0; }
  .nav a {
    position: relative;
    display: block;
    padding: 0.6rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--silver-200);
    text-decoration: none;
    border-radius: 999px;
    transition: color 0.2s, background 0.2s;
  }
  .nav a:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
  .nav a[aria-current='page'] { color: #fff; }
  .nav a[aria-current='page']::after {
    content: ''; position: absolute; left: 50%; bottom: 0.2rem;
    width: 4px; height: 4px; margin-left: -2px; border-radius: 50%;
    background: var(--silver-200);
  }

  .actions { display: flex; align-items: center; gap: 0.6rem; }
  .btn--sm { min-height: 2.5rem; padding: 0.5rem 1.15rem; font-size: 0.8125rem; }

  .burger {
    display: none;
    width: 2.75rem; height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgba(232, 236, 242, 0.22);
    background: rgba(255, 255, 255, 0.04);
    color: var(--silver-50);
    cursor: pointer;
    place-items: center;
    transition: transform 0.1s, background 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .burger:active { transform: scale(0.94); }
  .burger__lines { position: relative; width: 18px; height: 10px; display: block; }
  .burger__lines span {
    position: absolute; left: 0; width: 100%; height: 1.5px; border-radius: 2px;
    background: currentColor;
    transition: transform 0.45s var(--spring), top 0.45s var(--spring);
  }
  .burger__lines span:first-child { top: 0; }
  .burger__lines span:last-child { top: 8.5px; }
  .burger[aria-expanded='true'] .burger__lines span:first-child { top: 4.25px; transform: rotate(45deg); }
  .burger[aria-expanded='true'] .burger__lines span:last-child { top: 4.25px; transform: rotate(-45deg); }

  @media (max-width: 68rem) {
    .nav, .cta { display: none; }
    .actions { margin-inline-start: auto; }
    .burger { display: grid; }
  }
  @media (max-width: 26rem) {
    .bar { gap: 0.75rem; }
  }

  /* Mobile sheet: grows from the menu button and returns the same way */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 45;
    padding-top: calc(var(--header-h) + 1rem);
    padding-bottom: 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--silver-100);
    background:
      radial-gradient(120% 60% at 90% 0%, rgba(44, 67, 119, 0.55), transparent 60%),
      rgba(4, 7, 15, 0.94);
    -webkit-backdrop-filter: blur(28px) saturate(150%);
    backdrop-filter: blur(28px) saturate(150%);
    transform-origin: calc(100% - 2.5rem) 2.25rem;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.96);
    transition: opacity 0.3s var(--ease-out), transform 0.55s var(--spring), visibility 0s linear 0.55s;
  }
  :global([dir='rtl']) .sheet { transform-origin: 2.5rem 2.25rem; }
  .sheet[data-open] { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .sheet__inner { display: flex; flex-direction: column; gap: 2.5rem; min-height: 100%; }
  .sheet__links { list-style: none; margin: 0; padding: 0; }
  .sheet__links li {
    border-bottom: 1px solid rgba(188, 195, 208, 0.14);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s var(--ease-out), transform 0.6s var(--spring);
  }
  .sheet[data-open] .sheet__links li { opacity: 1; transform: none; transition-delay: calc(60ms + var(--i) * 35ms); }
  .sheet__links a {
    display: flex; align-items: baseline; gap: 1rem;
    padding: 0.9rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    line-height: 1.15;
    color: var(--silver-50);
    text-decoration: none;
  }
  .sheet__links a[aria-current='page'] { font-style: italic; }
  :global(:lang(ckb)) .sheet__links a { font-style: normal; font-size: 1.6rem; }
  .sheet__num { font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.1em; color: var(--silver-500); min-width: 1.5rem; }
  .sheet__label { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--silver-400); margin-bottom: 0.9rem; }
  :global(:lang(ckb)) .sheet__label { letter-spacing: 0; font-size: 0.875rem; }
  .sheet__foot { margin-top: auto; }
  .sheet__cta { display: grid; gap: 0.6rem; margin-top: 1.5rem; }
  .sheet__cta .btn--ghost { color: var(--silver-50); box-shadow: inset 0 0 0 1px rgba(232, 236, 242, 0.42); }
  @media (min-width: 68.0625rem) { .sheet { display: none; } }

  @media (prefers-reduced-transparency: reduce) {
    .site-header::before { background: var(--midnight-950); -webkit-backdrop-filter: none; backdrop-filter: none; }
    .sheet { background: var(--midnight-950); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const sheet = document.querySelector<HTMLElement>('[data-menu]')!;
  const main = document.getElementById('main');
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const labelOpen = toggle.querySelector<HTMLElement>('[data-label-open]')!;
  const labelClose = toggle.querySelector<HTMLElement>('[data-label-close]')!;

  const focusables = () =>
    [toggle, ...sheet.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];

  function setOpen(open: boolean) {
    sheet.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    labelOpen.hidden = open;
    labelClose.hidden = !open;
    header.classList.toggle('is-solid', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    [main, footer].forEach((el) => el && (el.inert = open));
    if (open) sheet.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
  }

  toggle.addEventListener('click', () => setOpen(!sheet.hasAttribute('data-open')));
  document.addEventListener('keydown', (e) => {
    if (!sheet.hasAttribute('data-open')) return;
    if (e.key === 'Escape') { setOpen(false); toggle.focus(); }
    if (e.key === 'Tab') {
      const items = focusables();
      const first = items[0], last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  window.matchMedia('(min-width: 68.0625rem)').addEventListener('change', (m) => m.matches && setOpen(false));
</script>
