---
import Wordmark from './Wordmark.astro';
import { getDict, localePath, type Locale } from '../i18n';
import { site, whatsappLink } from '../config/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const year = new Date().getFullYear();
---
<footer class="site-footer dark">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="top">
      <div class="brand-col">
        <a class="brand" href={localePath(locale)}>
          <img src="/logo.svg" width="56" height="56" alt="" loading="lazy" decoding="async" />
          <Wordmark class="big" />
        </a>
        <p class="tagline">{t.footer.tagline}</p>
      </div>

      <nav class="cols" aria-label={t.a11y.footerNav}>
        <div>
          <h2 class="col-title">{t.footer.explore}</h2>
          <ul role="list">
            <li><a href={localePath(locale, 'services')}>{t.nav.services}</a></li>
            <li><a href={localePath(locale, 'how-it-works')}>{t.nav.how}</a></li>
            <li><a href={localePath(locale, 'about')}>{t.nav.about}</a></li>
            <li><a href={localePath(locale, 'blog')}>{t.nav.blog}</a></li>
            <li><a href={localePath(locale, 'faq')}>{t.nav.faq}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="col-title">{t.footer.contact}</h2>
          <ul role="list">
            <li><a href={whatsappLink(t.contact.waPrefill)} rel="noopener" target="_blank">{t.cta.whatsapp}<span class="visually-hidden"> ({t.a11y.newTab})</span></a></li>
            <li><a href={`tel:${site.phoneHref}`} dir="ltr">{site.phoneDisplay}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li class="muted-line">{t.contact.based}</li>
          </ul>
        </div>
        <div>
          <h2 class="col-title">{t.footer.legal}</h2>
          <ul role="list">
            <li><a href={localePath(locale, 'privacy')}>{t.footer.privacy}</a></li>
            <li><a href={localePath(locale, 'cookies')}>{t.footer.cookies}</a></li>
            <li><a href={localePath(locale, 'terms')}>{t.footer.terms}</a></li>
            <li><a href={localePath(locale, 'accessibility')}>{t.footer.accessibility}</a></li>
            <li><button type="button" class="linklike" data-cookie-open>{t.footer.cookieSettings}</button></li>
          </ul>
        </div>
      </nav>
    </div>

    <hr class="rule" />
    <p class="disclaimer">{t.footer.disclaimer}</p>
    <p class="copy"><span>© {year} {site.name}. {t.footer.rights}</span><span>Norwich, Norfolk</span></p>
  </div>
</footer>

<style>
  .site-footer { position: relative; overflow: hidden; padding: clamp(4rem, 9vw, 7rem) 0 2.5rem; }
  .glow {
    position: absolute; inset: -40% -10% auto; height: 120%;
    background: radial-gradient(50% 50% at 50% 0%, rgba(44, 67, 119, 0.45), transparent 70%);
    pointer-events: none;
  }
  .wrap { position: relative; }
  .top { display: grid; gap: 3rem; grid-template-columns: 1.1fr 2fr; margin-bottom: 3.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 1rem; color: var(--silver-50); text-decoration: none; }
  .brand img { width: 3.5rem; height: 3.5rem; border-radius: 0.8rem; }
  .brand :global(.big) { font-size: 2.1rem; }
  .tagline { margin-top: 1.5rem; max-width: 22rem; color: var(--silver-400); font-size: 0.9375rem; }
  .cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .col-title {
    font-family: var(--font-body); font-size: 0.6875rem; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--silver-500);
    margin-bottom: 1.1rem;
  }
  :global(:lang(ckb)) .col-title { letter-spacing: 0; font-size: 0.875rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  a, .linklike { color: var(--silver-200); text-decoration: none; font-size: 0.9375rem; overflow-wrap: anywhere; }
  a:hover, .linklike:hover { color: #fff; text-decoration: underline; }
  .linklike { background: none; border: 0; padding: 0; font: inherit; font-size: 0.9375rem; cursor: pointer; text-align: start; }
  .muted-line { color: var(--silver-500); font-size: 0.875rem; }
  .disclaimer { margin: 2rem 0 1.5rem; max-width: 52rem; font-size: 0.8125rem; line-height: 1.7; color: var(--silver-400); }
  .copy { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; font-size: 0.8125rem; color: var(--silver-500); }
  @media (max-width: 56rem) {
    .top { grid-template-columns: 1fr; }
  }
  @media (max-width: 36rem) {
    .cols { grid-template-columns: 1fr 1fr; }
    .cols > div:last-child { grid-column: 1 / -1; }
  }
</style>
