---
import Photo from './Photo.astro';
import type { PhotoKey } from '../config/photos';
import { getDict, localePath, type Locale } from '../i18n';

interface Props { locale: Locale; kicker?: string; title: string; lead?: string; photo?: PhotoKey; crumbs?: { label: string; href?: string }[] }
const { locale, kicker, title, lead, photo, crumbs = [] } = Astro.props;
const t = getDict(locale);
const trail = [{ label: t.nav.home, href: localePath(locale) }, ...crumbs];
---
<section class="head dark">
  {photo && <div class="head__photo" aria-hidden="true"><Photo name={photo} locale={locale} eager decorative sizes="100vw" /></div>}
  <div class="head__veil" aria-hidden="true"></div>
  <div class="wrap head__inner">
    <nav aria-label={t.a11y.breadcrumb} class="crumbs">
      <ol role="list">
        {trail.map((c, i) => (
          <li>{c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
        ))}
      </ol>
    </nav>
    {kicker && <p class="kicker">{kicker}</p>}
    <h1 class="display head__title">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .head {
    position: relative;
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(3.5rem, 9vw, 7rem)) 0 clamp(3.5rem, 8vw, 6rem);
    isolation: isolate;
  }
  .head__photo { position: absolute; inset: 0; z-index: -2; }
  .head__photo :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: 0.38; filter: saturate(0.6) contrast(1.05); }
  .head__veil {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(70% 90% at 80% 0%, rgba(44, 67, 119, 0.55), transparent 65%),
      linear-gradient(180deg, rgba(4, 7, 15, 0.55), rgba(4, 7, 15, 0.92) 85%);
  }
  .head__title { max-width: 16ch; margin-bottom: 1.5rem; }
  :global(:lang(ckb)) .head__title { max-width: 22ch; font-size: clamp(2.25rem, 5.5vw, 4.25rem); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0 0 2.5rem; padding: 0; font-size: 0.8125rem; color: var(--silver-400); }
  .crumbs li + li::before { content: '/'; margin-inline-end: 0.5rem; opacity: 0.5; }
  .crumbs a { color: var(--silver-300); text-decoration: none; }
  .crumbs a:hover { color: #fff; text-decoration: underline; }
</style>
