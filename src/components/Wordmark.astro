---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`wordmark ${cls}`} translate="no" lang="en">Advice<span class="four">4</span>you</span>

<style>
  .wordmark {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }
  .four {
    font-style: italic;
    font-weight: 600;
    margin-inline: 0.04em;
    background: var(--brushed);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
