---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import Mark from '../components/Mark.astro';
import { getDict, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const a = t.about;
---
<Base locale={locale} path="about" title={a.title} description={a.description}>
  <PageHead locale={locale} kicker={a.kicker} title={a.h1} lead={a.lead} photo="skyline" crumbs={[{ label: t.nav.about }]} />

  <section class="section">
    <div class="wrap story">
      <div class="story__text">
        <Mark />
        {a.paras.map((p, i) => <p class={i === 0 ? 'first' : 'lead'} data-reveal>{p}</p>)}
      </div>
      <figure class="story__media" data-reveal>
        <Photo name="skyline" locale={locale} sizes="(min-width: 56rem) 45vw, 100vw" />
      </figure>
    </div>
  </section>

  <section class="section ivory-2">
    <div class="wrap duo">
      <div class="duo__col" data-reveal>
        <h2 class="h3">{a.areTitle}</h2>
        <ul role="list" class="yes">{a.areItems.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="duo__col duo__col--dark" data-reveal style="--delay: 100ms">
        <h2 class="h3">{a.notTitle}</h2>
        <ul role="list" class="no">{a.notItems.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap narrow area" data-reveal>
      <p class="kicker">{a.areaTitle}</p>
      <p class="area__text">{a.areaText}</p>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .story { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .story__text { display: grid; gap: 1.5rem; }
  .story__text :global(.mark) { color: var(--midnight-600); }
  .first { font-family: var(--font-display); font-size: clamp(1.6rem, 2.8vw, 2.25rem); line-height: 1.25; }
  :global(:lang(ckb)) .first { font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.7; }
  .story__media { margin: 0; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 5; background: var(--midnight-800); }
  .story__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .duo__col { padding: clamp(1.75rem, 4vw, 3rem); border-radius: var(--radius); background: var(--ivory); border: 1px solid var(--ivory-line); }
  .duo__col--dark { background: var(--ink); color: var(--silver-200); border-color: var(--ink); }
  .duo__col--dark h2 { color: var(--silver-50); }
  .duo h2 { margin-bottom: 1.5rem; }
  .duo ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .duo li { position: relative; padding-inline-start: 2rem; }
  .yes li::before { content: ''; position: absolute; inset-inline-start: 0.1rem; top: 0.35em; width: 0.9rem; height: 0.5rem; border-inline-start: 1.5px solid var(--midnight-600); border-bottom: 1.5px solid var(--midnight-600); transform: rotate(-45deg); }
  .no li::before, .no li::after { content: ''; position: absolute; inset-inline-start: 0.1rem; top: 0.8em; width: 0.9rem; height: 1.5px; background: var(--silver-400); transform: rotate(45deg); }
  .no li::after { transform: rotate(-45deg); }
  .area__text { font-family: var(--font-display); font-size: clamp(1.75rem, 3.4vw, 2.75rem); line-height: 1.2; }
  :global(:lang(ckb)) .area__text { font-size: clamp(1.3rem, 2.6vw, 1.9rem); line-height: 1.7; }
  @media (max-width: 56rem) { .story, .duo { grid-template-columns: 1fr; } .story__media { aspect-ratio: 16 / 10; } }
</style>
