---
import { site } from '../config/site';
import { locales, localeInfo, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path: string;          // shared page path without locale, e.g. 'faq' or 'blog/first-weeks'
  title: string;
  description: string;
  image?: string;        // absolute URL
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
}

const { locale, path, title, description, image, type = 'website', jsonLd = [], noindex = false } = Astro.props;
const abs = (p: string) => new URL(p, site.url).toString();
const canonical = abs(localePath(locale, path));
const ogImage = image ?? abs('/og/advice4you.jpg');
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{!noindex && locales.map((l) => <link rel="alternate" hreflang={localeInfo[l].hreflang} href={abs(localePath(l, path))} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={abs(localePath('en', path))} />}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={localeInfo[locale].ogLocale} />
{locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeInfo[l].ogLocale} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
