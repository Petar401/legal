---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/vazirmatn';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import cormorantLatin from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import vazirArabic from '@fontsource-variable/vazirmatn/files/vazirmatn-arabic-wght-normal.woff2?url';

import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Chatbot from '../components/Chatbot.astro';
import { getDict, localeInfo, localePath, type Locale } from '../i18n';
import { site } from '../config/site';

interface Props {
  locale: Locale;
  path: string;
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  preloadImage?: { href: string; srcset: string; sizes: string };
}

const { locale, path, title, description, image, type, jsonLd = [], noindex, preloadImage } = Astro.props;
const info = localeInfo[locale];
const t = getDict(locale);

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organisation`,
  name: site.name,
  url: site.url + localePath(locale),
  logo: `${site.url}/icon-512.png`,
  image: `${site.url}/og/advice4you.jpg`,
  description: t.meta.defaultDescription,
  email: site.email,
  telephone: site.phoneDisplay,
  areaServed: [
    { '@type': 'City', name: 'Norwich' },
    { '@type': 'AdministrativeArea', name: 'Norfolk' },
  ],
  knowsLanguage: ['en', 'bg', 'ro', 'tr', 'ku', 'ckb'],
};
---
<!doctype html>
<html lang={info.htmlLang} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#04070f" />
    <meta name="color-scheme" content="light" />
    <script is:inline>
      (function (d) {
        d.classList.add('js');
        var c = null;
        try { c = localStorage.getItem('a4y-consent'); } catch (e) {}
        if (!c) d.classList.add('has-cookie');
      })(document.documentElement);
    </script>
    <link rel="preconnect" href="https://images.unsplash.com" />
    {locale === 'ckb'
      ? <link rel="preload" href={vazirArabic} as="font" type="font/woff2" crossorigin />
      : <><link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin /><link rel="preload" href={cormorantLatin} as="font" type="font/woff2" crossorigin /></>}
    {preloadImage && <link rel="preload" as="image" href={preloadImage.href} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo locale={locale} path={path} title={title} description={description} image={image} type={type} noindex={noindex} jsonLd={[organisation, ...jsonLd]} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieBanner locale={locale} />
    <Chatbot locale={locale} />

    <script>
      // Gentle reveal as sections enter the viewport. Content is visible if this never runs.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
